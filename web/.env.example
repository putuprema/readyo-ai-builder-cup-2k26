# Base URL of the api service, without a trailing slash.
# Local default is the api dev server. In production, scripts/deploy-web.sh sets the Cloud Run URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Firebase web app config (Project settings → Your apps). The result and progress pages read
# goals, analyses and runs from Firestore with these; without a project id they show the
# shared demo analysis.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=adidi-ai-cup-builder-2026.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=adidi-ai-cup-builder-2026
# Local development against the emulators (scripts/with-emulators.sh, project demo-adidi):
# the pages connect to the Auth and Firestore emulators and sign in as the seeded demo user.
# NEXT_PUBLIC_USE_EMULATORS=1
