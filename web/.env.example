# Base URL of the api service, without a trailing slash.
# Local default is the api dev server. In production, scripts/deploy-web.sh sets the Cloud Run URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase web app (Firebase console > Project settings > Your apps). These are public
# client-side identifiers, not secrets; access is enforced by firestore.rules. Without a
# project id the progress and result pages show the shared demo analysis.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=adidi-ai-cup-builder-2026
NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=adidi-ai-cup-builder-2026.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Password of the demo account (pnpm seed:demo), filled in on the sign-in card with its email
# (demo@example.com) so judges only press Sign in. It ends up in the public bundle, so use it
# only for the demo account. On the emulators the seed's default is demo-pass-2026.
# NEXT_PUBLIC_DEMO_PASSWORD=

# Local development against the Firebase emulators (pnpm emulators): Auth on 9099 and
# Firestore on 8085 under the demo project, no Firebase config needed.
# NEXT_PUBLIC_USE_EMULATORS=1
