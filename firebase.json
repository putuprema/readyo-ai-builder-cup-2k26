{
  "hosting": {
    "public": "web/out",
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/goals/*/documents{,/**}",
        "destination": "/goals/_/documents/index.html"
      },
      {
        "source": "/goals/*/progress{,/**}",
        "destination": "/goals/_/progress/index.html"
      },
      {
        "source": "/goals/*/result{,/**}",
        "destination": "/goals/_/result/index.html"
      }
    ],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
