# Local overrides for the api service. Copy to .env (ignored by git).
PORT=8080
# Set by scripts/deploy-service.sh on Cloud Run; "dev" when unset.
# GIT_SHA=
# Secrets come from Secret Manager on Cloud Run (--set-secrets), never from the repo.
# GEMINI_API_KEY=
# Optional overrides of the model aliases in api/src/gemini/client.ts
# (defaults: gemini-pro-latest and gemini-flash-latest).
# GEMINI_PRO_MODEL=
# GEMINI_FLASH_MODEL=
# Model tier for goal pricing (stage 1): flash (default, about 20 s) or pro (about 50 s).
# PRICING_MODEL_TIER=flash
# Firebase project for ID token verification. Falls back to GOOGLE_CLOUD_PROJECT (set on Cloud Run).
# FIREBASE_PROJECT_ID=adidi-ai-cup-builder-2026
# Extra browser origins allowed by CORS (comma-separated). localhost and *.web.app are always allowed.
# CORS_ORIGINS=
# Verify tokens against the Auth emulator instead of Firebase (local development only).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Runs (POST /runs, spec 07): the worker's URL and how to reach it. Without WORKER_URL the
# endpoint answers 501. TASKS_MODE=direct posts to the worker at once (local development and
# the emulators); otherwise a Cloud Task is created in TASKS_QUEUE with an OIDC token for
# TASKS_SERVICE_ACCOUNT (needs roles/run.invoker on the worker).
# WORKER_URL=http://localhost:8081
# TASKS_MODE=direct
# TASKS_QUEUE=runs
# TASKS_LOCATION=asia-southeast1
# TASKS_SERVICE_ACCOUNT=tasks-invoker@adidi-ai-cup-builder-2026.iam.gserviceaccount.com
