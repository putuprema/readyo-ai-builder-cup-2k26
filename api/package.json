{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "seed:rules": "tsx --env-file-if-exists=.env scripts/seed-rules.ts",
    "test:live": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run live"
  },
  "dependencies": {
    "@adidi/shared": "workspace:*",
    "@google-cloud/tasks": "^7.3.0",
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^1",
    "firebase-admin": "^14.5.0",
    "hono": "^4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsx": "^4",
    "vitest": "^5.0.5"
  }
}
