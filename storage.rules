rules_version = '2';

// Uploads live at users/{uid}/documents/{docId} in the default bucket (specs/01-contracts.md).
// Browsers never touch the bucket directly: the api hands out signed URLs and the worker reads
// and deletes with the Admin SDK, which bypasses these rules. Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
