# Dependencies and build output
node_modules/
dist/
.next/
out/
*.tsbuildinfo

# Environment and secrets: never commit these
.env
.env.*
!.env.example
*service-account*.json
*serviceAccountKey*.json
*.pem
*.key

# Firebase and gcloud local state
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.gcloudignore.local

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test and coverage output
coverage/

# Real statements stay local until they are anonymised (fixtures/README.md); the expected
# JSON next to them holds only dates, amounts and merchant names and is committed.
fixtures/statements/*
!fixtures/statements/.gitkeep

# Next.js generated
next-env.d.ts
