{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "accuracy": "tsx --env-file-if-exists=.env scripts/accuracy.ts",
    "test:live": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run live",
    "fixtures:paylater": "tsx scripts/make-sample-paylater.ts",
    "fixtures:samples": "tsx scripts/make-sample-statements.ts && tsx scripts/make-sample-paylater.ts"
  },
  "dependencies": {
    "@adidi/shared": "workspace:*",
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "hono": "^4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.20.2",
    "tsx": "^4",
    "vitest": "^5.0.5"
  }
}
